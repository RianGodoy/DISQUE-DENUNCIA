# Copie para .env.local e preencha com os dados do projeto Supabase do canal
# (Project Settings > API). Sem URL e chave o site roda em MODO DEMONSTRAÇÃO:
# tudo fica só no navegador e ninguém recebe as denúncias.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública. Formato novo ("sb_publishable_...") ou antigo ("anon", eyJ...),
# qualquer um dos dois. Nunca use aqui a chave secreta / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
